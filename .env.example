# ── ForgeAI Root .env ─────────────────────────────────────────────────────────
# This file is read by docker-compose to inject secrets into containers.
# Copy from .env.example and fill in real values.
# NEVER commit this file to version control.

# ── JWT Secret (must be the same across api + repository service) ─────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── GitHub App (shared by repository + worker services) ───────────────────────
GITHUB_APP_ID=
GITHUB_APP_NAME=forgeai-local
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── OpenAI (used by worker for embedding generation) ──────────────────────────
OPENAI_API_KEY=

# ── Qdrant API Key (optional — leave empty for local development) ──────────────
QDRANT_API_KEY=

# ── Kafka (set to true to enable real Kafka publishing from repository service) ─
KAFKA_ENABLED=true
