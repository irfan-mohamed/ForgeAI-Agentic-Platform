# ForgeAI local development environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
#
# Generate a strong SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=change-me-use-a-strong-password
# URL-encoded version of POSTGRES_PASSWORD for use inside the DATABASE_URL
# string. Replace every special char: @ → %40, # → %23, % → %25, etc.
# Example: "my@pass#word" → "my%40pass%23word"
POSTGRES_PASSWORD_ENCODED=change-me-url-encoded-version-of-POSTGRES_PASSWORD
POSTGRES_DB=forgeai

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-64-char-random-hex-string

# ── GitHub App ─────────────────────────────────────────────────────────────────
GITHUB_APP_ID=your-github-app-numeric-id
GITHUB_APP_NAME=forgeai-local
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Personal access token used by Phase 4 build runner to open PRs
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ── AI / LLM ───────────────────────────────────────────────────────────────────
# Free tier at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_REVIEW_MODEL=openai/gpt-oss-120b

# ── Redis ───────────────────────────────────────────────────────────────────────
# In docker-compose the service name is "redis"
REDIS_URL=redis://redis:6379/0

# ── Kafka ───────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=true

# ── Observability (opt-in) ─────────────────────────────────────────────────────
# Set to true to enable OTel traces to Jaeger
OTEL_ENABLED=false
