# Repository Service — Local Development Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://forgeai:Irfan%40123@localhost:5432/forgeai

# ── JWT (must match api service SECRET_KEY exactly) ───────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256

# ── GitHub App ────────────────────────────────────────────────────────────────
# Create your GitHub App at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_NAME=forgeai-dev
# Paste the full PEM private key (including header/footer lines)
GITHUB_APP_PRIVATE_KEY=

# Secret used to validate incoming webhook payloads
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Where GitHub redirects after OAuth installation completes
GITHUB_CALLBACK_REDIRECT_URL=http://localhost:5173/github/callback

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Start as false — events are only logged until Worker service is built
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
