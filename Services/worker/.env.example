# Worker Service — Local Development Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Shared PostgreSQL instance with the api and repository services.
DATABASE_URL=postgresql+psycopg://forgeai:Irfan%40123@localhost:5432/forgeai

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=forgeai-worker
KAFKA_TOPIC_REPOSITORY_EVENTS=repository.events
KAFKA_TOPIC_REPOSITORY_SYNC=repository.sync
# How many messages to prefetch per partition
KAFKA_MAX_POLL_RECORDS=10

# ── GitHub App (for fetching repository files during sync) ────────────────────
GITHUB_APP_ID=
GITHUB_APP_NAME=forgeai-local
# Full PEM private key (multiline).
GITHUB_APP_PRIVATE_KEY=
# Preferred for Docker — path to mounted PEM file (takes precedence over above)
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_API_BASE_URL=https://api.github.com

# ── Embeddings (fastembed — local, no API key required) ──────────────────────
# Model is downloaded from HuggingFace on first run and cached locally.
# BAAI/bge-small-en-v1.5 → 384 dimensions, fast, high quality.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Dimensions MUST match the Qdrant collection config.
EMBEDDING_DIMENSIONS=384

# ── Qdrant (vector database) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collection name — all orgs/repos stored in one collection, isolated by metadata
QDRANT_COLLECTION_NAME=repository_knowledge

# ── Chunking ──────────────────────────────────────────────────────────────────
# Max tokens per chunk (text-embedding-3-small supports up to 8191)
CHUNK_MAX_TOKENS=512
# Overlap tokens between consecutive chunks (maintains context continuity)
CHUNK_OVERLAP_TOKENS=64

# ── Local clone directory ──────────────────────────────────────────────────────
# Where cloned repositories are temporarily stored during sync
CLONE_BASE_DIR=/tmp/forgeai_worker_clones

# ── Service Identity ──────────────────────────────────────────────────────────
PROJECT_NAME=ForgeAI Worker Service
